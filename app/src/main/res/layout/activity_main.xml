<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 DANA Listener"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-forward notif DANA ke Telegram bot"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mengecek status..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#1E1E1E"
            android:padding="14dp"
            android:layout_marginBottom="20dp"/>

        <!-- Webhook URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Webhook URL"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://IP:PORT/webhook/dana"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:textSize="13sp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp"/>

        <!-- Webhook Secret -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Webhook Secret"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="x-webhook-secret kamu"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:textSize="13sp"
            android:inputType="textPassword"
            android:layout_marginBottom="20dp"/>

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾 Simpan Config"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- Tombol Izin Notifikasi -->
        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔔 Kasih Izin Akses Notifikasi"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- Log Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG AKTIVITAS"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada aktivitas."
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>
