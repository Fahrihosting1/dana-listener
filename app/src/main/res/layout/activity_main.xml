<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 DANA Listener"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-forward notif DANA ke webhook"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- STATUS -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mengecek status..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#1E1E1E"
            android:padding="14dp"
            android:layout_marginBottom="20dp"/>

        <!-- WEBHOOK URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Webhook URL"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://yourapp.vercel.app/api/webhook"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:textSize="13sp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp"/>

        <!-- WEBHOOK SECRET -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Webhook Secret"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="x-webhook-secret kamu"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:textSize="13sp"
            android:inputType="textPassword"
            android:layout_marginBottom="20dp"/>

        <!-- HEADER IZIN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IZIN YANG DIBUTUHKAN"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <!-- SIMPAN -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾 Simpan Config"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- CEK NOTIF MANUAL -->
        <Button
            android:id="@+id/btnManual"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔍 Cek Notif Manual"
            android:backgroundTint="#00838F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- IZIN NOTIFIKASI -->
        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔔 Kasih Izin Akses Notifikasi"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- BATTERY OPTIMIZATION -->
        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔋 Nonaktifkan Battery Optimization"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- OVERLAY / TAMPIL DI ATAS LAYAR -->
        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📌 Izinkan Tampil di Atas Layar"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- MIUI AUTOSTART — hanya muncul di Xiaomi/Redmi/POCO -->
        <Button
            android:id="@+id/btnMiui"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🤖 Xiaomi: Aktifkan MIUI Autostart"
            android:backgroundTint="#FF6900"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <!-- OPPO/REALME/ONEPLUS battery whitelist -->
        <Button
            android:id="@+id/btnOppo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📱 Oppo/Realme: Battery Whitelist"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <!-- VIVO battery whitelist -->
        <Button
            android:id="@+id/btnVivo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📱 Vivo: Battery Whitelist"
            android:backgroundTint="#4A148C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>

        <!-- LOG -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG AKTIVITAS"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada aktivitas."
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>
